{
  "expo": {
    "name": "DrinkInModeration",
    "slug": "drinkin-moderation",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "drinkinmoderation",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.jeffreyouma.drinkinmoderation",
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "shortName": "DIM"
    },
    "plugins": [
      "expo-router",
      "expo-notifications"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "fd1b45c5-8481-4336-b313-a9be979d777d"
      }
    }
  }
}
