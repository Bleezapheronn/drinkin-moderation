{
  "expo": {
    "name": "One More Drink",
    "slug": "one-more-drink",
    "version": "1.0.0",
    "description": "Make a sober plan. Stick to it.",
    "icon": "./assets/icon.png",
    "orientation": "portrait",
    "scheme": "onemoredrink",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#f7f4ef"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1f2a2e"
      },
      "package": "com.bleezapheronn.onemoredrink",
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "shortName": "OMD"
    },
    "plugins": [
      "expo-router",
      [
        "expo-notifications",
        {
          "sounds": [
            "./assets/sounds/interval.mp3",
            "./assets/sounds/go_home.mp3"
          ]
        }
      ],
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "02fb5196-d3f2-4969-99d1-73f02359bb67"
      }
    },
    "owner": "bleezapheronn"
  }
}
